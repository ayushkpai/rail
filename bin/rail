#!/usr/bin/env ruby

print "What is the app name?\n> "
app = gets&.strip

print "\nDo you want to use Tailwind CSS? [Y/n] "
use_tailwind = gets&.strip.to_s.downcase

case use_tailwind
when "", "y", "yes"
  system("rails", "new", app, "--css", "tailwind")
when "n", "no"
  system("rails", "new", app)
else
  exit 1
end
